<?xml version="1.0" encoding="utf-8"?>
<!-- 启动页：纸色底 + 居中的纸条 logo，和首屏纸色衔接，避免白屏闪一下。
     图片由 tool/gen_app_icon.py 生成（drawable-*dpi/launch_logo.png）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_bg" />

    <item>
        <bitmap
            android:gravity="center"
            android:filter="true"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>